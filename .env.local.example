# Salin file ini jadi .env.local dan isi nilainya.
# NEXT_PUBLIC_* aman ditaruh di client HANYA jika RLS policy tabel-tabel di bawah
# ini sudah kamu verifikasi read-only untuk role anon (lihat README bagian RLS).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-anon-key-kamu

# Opsional tapi sangat disarankan: RPC pribadi (Helius/QuickNode/dst) supaya
# tidak kena rate limit RPC publik terus-terusan.
NEXT_PUBLIC_RPC_URL_PRIMARY=
